// Prisma Schema for TripTags

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}

// ========= enum ===========

enum UserRole {
  USER
  USER_LOCAL
  BUSINESS
  ADMIN
}

enum Provider {
  GOOGLE
  KAKAO
  NAVER
  LOCAL
}

enum VenueCategory {
  RESTAURANT
  CAFE
  HOTEL
  STREET_FOOD
  BAR
  ATTRACTION
  ACTIVITY
  SHOPPING
  NATURE
  CULTURE
}

enum PointType {
  REVIEW_WRITE
  VENUE_CREATE
  HELPFUL_RECEIVED
  LOCAL_VERIFIED
}

enum VerificationMethod {
  ADDRESS
  GPS
  ACTIVITY
}

enum ImageSource {
  OAUTH_API
  TOUR_API
  USER_UPLOAD
}


// ======== User Table =========

model User { 
  id                 String                @id @default(uuid()) @db.Uuid
  email              String                @db.VarChar(255)
  password           String?               @db.Text
  nickname           String                @db.VarChar(100)
  role               UserRole              @default(USER)
  profileImage       String?               @db.Text @map("profile_image")
  provider           Provider              @default(LOCAL)
  providerId         String?               @db.VarChar(255) @map("provider_id")   
  language           String                @db.VarChar(255) @default("ko")  
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  deletedAt          DateTime?             @map("deleted_at")
  profile            UserProfile?
  point              UserPoint[]
  localVerifications LocalVerification[]
  venues             Venue[]
  tag                Tag[]
  review             Review[]
  @@unique([provider, providerId])
  @@map("users")
}

model UserProfile {
  id                String      @id @default(uuid()) @db.Uuid
  detailedAddress   String      @db.Text @map("detailed_address")
  latitude          Float      
  longitude         Float
  introduction      String      @db.Text
  reviewCount       Int         @default(0) @map("review_count")
  helpfulCount      Int         @default(0) @map("helpful_count")
  deletedAt         DateTime?   @map("deleted_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  //테이블 연관요소
  userId            String      @unique @map("user_id") @db.Uuid
  user              User        @relation(fields: [userId], references:[id], onDelete:Cascade)
  regionId          String      @map("region_id") @db.Uuid
  region            Region      @relation(fields:[regionId], references:[id])
  @@map("user_profiles")
}

model LocalVerification {
  id                    String              @id @default(uuid()) @db.Uuid
  longitude             Float
  latitude              Float         
  verificationMethod    VerificationMethod  @map("verification_method")
  createdAt             DateTime            @default(now()) @map("created_at")  
  deletedAt             DateTime?           @map("deleted_at")
  //테이블 간 연관요소
  userId                String              @map("user_id") @db.Uuid
  user                  User                @relation(fields:[userId], references:[id], onDelete:Cascade)
  venueId               String?             @db.Uuid @map("venue_id")
  venue                 Venue?              @relation(fields:[venueId], references:[id])               
  regionId              String              @map("region_id") @db.Uuid
  region                Region              @relation(fields: [regionId], references:[id], onDelete:Cascade)
  userPoint             UserPoint[]
  @@map("local_verifications")
}

model UserPoint{
  id                   String               @id @default(uuid()) @db.Uuid 
  point                Int                  @default(0)
  pointActivity        PointType            @map("point_activity")
  localVerified        VerificationMethod?  @map("local_verified")
  createdAt            DateTime             @default(now()) @map("created_at")
  deletedAt            DateTime?            @map("deleted_at")
  //연관요소  
  userId               String               @db.Uuid @map("user_id")
  localVerificationId  String?              @db.Uuid @map("local_verification_id")
  venueId              String?              @db.Uuid @map("venue_id")
  user                 User                 @relation(fields:[userId], references:[id], onDelete: Cascade)
  venue                Venue?               @relation(fields:[venueId], references:[id])
  localVerification    LocalVerification?   @relation(fields:[localVerificationId], references:[id])
  @@map("user_points")
}

model BusinessVerification {
  id                   String      @id @default(uuid()) @db.Uuid
  businessName         String      @db.VarChar(100) @map("business_name")
  businessNumber       String      @db.VarChar(100) @map("business_number")
  businessVerified     Boolean     @default(false)  @map("business_verified")
  createdAt            DateTime    @default(now())  @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deletedAt            DateTime?   @map("deleted_at")
  // user테이블 관련요소 
  userId               String      @db.Uuid @unique @map("user_id")
  user                 User        @relation(fields:[userId],references:[id],onDelete: Cascade)
  @@map("business_verification")
}

// ====== Region Table ======
model Region {
  id                  String               @id @default(uuid()) @db.Uuid
  country             String               @db.VarChar(100)
  city                String               @db.VarChar(100) 
  district            String               @db.VarChar(100) 
  subdistrict         String               @db.VarChar(100) 
  userProfile         UserProfile[]
  localVerification   LocalVerification[] 
  venue               Venue[]
  @@unique([country, city, district, subdistrict])
  @@index([country, city])
  @@map("regions")
}

// ====== Venue Table ======
model Venue {
  id                     String               @id @default(uuid()) @db.Uuid
  name                   Json
  description            Json
  latitude               Float              
  longitude              Float 
  tourApiContentId       String?              @map("tour_api_content_id")
  googlePlaceId          String?              @map("google_place_id")
  mainImage              String?              @map("main_image")
  overallRating          Float                @default(0) @map("overall_rating")
  reviewCount            Int                  @default(0) @map("review_count")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  deletedAt              DateTime?            @map("deleted_at")
  //user table, local verification 연관요소
  createdBy              String               @map("created_by") @db.Uuid
  user                   User                 @relation(fields:[createdBy], references:[id], onDelete: Cascade)
  regionId               String               @db.Uuid @map("region_id")
  region                 Region               @relation(fields:[regionId], references:[id], onDelete:Cascade)
  venueDetail            VenueDetail?         
  localVerifications     LocalVerification[]
  googlePlace            GooglePlace?      
  venueImage             VenueImage[]
  venueTag               VenueTag[]
  venueStats             VenueStats?
  @@map( "venues")
}

model VenueDetail {
  id            String      @id @default(uuid()) @db.Uuid
  phoneNumber   String      @db.VarChar(100) @map("phone_number")
  priceRange    String      @db.VarChar(100) @map("price_range")
  subCategory   String      @db.VarChar(100) @map("sub_category")
  websiteUrl    String      @db.VarChar(100) @map("website_url")
  work_hour     Json        @map("work_hour")
  description   Json         
  createdAt     DateTime    @default(now()) @map("created_at") 
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")  
  //Venue와 연관   
  venueId       String      @map("venue_id") @unique @db.Uuid
  venue         Venue       @relation(fields:[venueId], references:[id], onDelete: Cascade)
  @@map("venue_details")
}

model GooglePlace {
  id                String   @id @default(uuid()) @db.Uuid 
  googlePlaceId     String   @db.VarChar(255) @map("google_place_id") 
  googleRating      Float    @map("google_rating") @default(0)
  googleType        String   @db.VarChar(255) @map("google_types")
  googleUrl         String   @map("google_url")
  createdAt         DateTime @default(now()) @map("created_at")
  venueId           String   @db.Uuid @map("venue_id") @unique
  //테이블 연관내용
  venue             Venue    @relation(fields:[venueId], references:[id], onDelete: Cascade)     
  @@map("google_place")
}

model VenueImage {
  id                String            @id @default(uuid()) @db.Uuid 
  isThumbnail       Boolean           @default(false) @map("is_thumbnail")
  imageSource       ImageSource       @map("image_source")  
  createdAt         DateTime          @default(now()) @map("created_at")
  venueId           String            @db.Uuid @map("venue_id")
  //테이블 연관내용
  venue             Venue             @relation(fields:[venueId], references:[id], onDelete: Cascade)     
  @@map("venue_images")
}

model VenueStats {
  id                String            @id @default(uuid()) @db.Uuid 
  ratingAvg         Float             @default(0) @map("rating_avg")
  reviewCount       Int               @default(0) @map("review_count")
  localRatingAvg    Float             @default(0) @map("local_rating_avg")
  venueId           String            @map("venue_id") @db.Uuid @unique
  //table
  venue             Venue             @relation(fields:[venueId], references:[id], onDelete:Cascade) 
  @@map("venue_stats")
}

model Tag{
  id                String            @id @default(uuid()) @db.Uuid
  tagName           String            @db.VarChar(100) @map("tag_name") @unique
  systemTag         Boolean           @map("system_tag")
  // user Table
  creatorId         String?           @db.Uuid @map("creator_id")
  user              User?             @relation(fields:[creatorId], references:[id])  
  venueTags         VenueTag[]
  @@map("tags")
}

model VenueTag {
  venueId       String    @map("venue_id") @db.Uuid
  tagId         String    @map("tag_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  venue         Venue     @relation(fields:[venueId], references:[id], onDelete: Cascade)
  tag           Tag       @relation(fields:[tagId], references:[id],onDelete: Cascade)
  @@id([venueId, tagId])
  @@map("venue_tags")
}

// ====== Review Table ======
model Review {
  id                String            @id @default(uuid()) @db.Uuid
  rating            Int               @default(0)
  contents          Json
  authorRole        UserRole          @default(USER) @map("author_role")
  isLocalVerified   Boolean           @map("is_local_verified") @default(false) 
  likeCount         Int               @map("like_count") @default(0)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")
  venueId           String            @db.Uuid @map("venue_id")
  venue             Venue             @relation(fields:[venueId], references:[id], onDelete:Cascade)
  userId            String?           @db.Uuid @map("user_id")
  user              User?             @relation(fields:[userId], references:[id], onDelete: SetNull)
  reviewHelpfuls    ReviewHelpful[]
  reviewImages      ReviewImage[]  
  reviewDetail      ReviewDetail?
  @@map("reviews")
}


model ReviewDetail {
  id                String            @id @default(uuid()) @db.Uuid
  tasteRating       Int               @default(0) @map("taste_rating")
  serviceRating     Int               @default(0) @map("service_rating")
  priceRating       Int               @default(0) @map("price_rating") 
  visitDate         DateTime?         @map("visit_date")
  visitPurpose      String            @db.Text @map("visit_purpose")
  createdAt         DateTime          @default(now()) @map("created_at")
  reviewId          String            @db.Uuid @map("review_id") @unique
  review            Review            @relation(fields:[reviewId], references:[id], onDelete:Cascade)
  @@map("review_details")
}

model ReviewHelpful {
  id                String            @id @default(uuid()) @db.Uuid
  reviewId          String            @db.Uuid @map("review_id")
  userId            String            @db.Uuid @map("user_id")
  user              User?             @relation(fields:[userId], references:[id], onDelete:SetNull)
  review            Review            @relation(fields:[reviewId], references:[id], onDelete:Cascade)
  @@unique([reviewId, userId])
  @@map("review_helpful")
}

model ReviewImage {
    id                String            @id @default(uuid()) @db.Uuid
    mainImage         Boolean           @default(false)
    imageUrl          String            @map("image_url")
    reviewId          String            @db.Uuid @map("review_id")
    review            Review            @relation(fields:[reviewId], references:[id])
    @@map("review_images")
}



{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "skipLibCheck": true,
    // "rootDir": "./src",
    "outDir": "./dist", //scripts에서 조정
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@triptags/database": ["../database/src/index.ts"]
    }
  },
  "include": ["src/**/*", "../database/src/index.ts"]
}

// Prisma Schema for TripTags

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========= enum ===========

enum UserRole {
  USER
  USER_LOCAL
  BUSINESS
  ADMIN
}

enum Provider {
  GOOGLE
  KAKAO
  NAVER
  LOCAL
}

enum VenueCategory {
  RESTAURANT
  CAFE
  HOTEL
  STREET_FOOD
  BAR
  ATTRACTION
  ACTIVITY
  SHOPPING
  NATURE
  CULTURE
}

enum PointType {
  REVIEW_WRITE
  VENUE_CREATE
  HELPFUL_RECEIVED
  LOCAL_VERIFIED
}

enum VerificationMethod {
  ADDRESS
  GPS
  ACTIVITY
}

enum ImageSource {
  OAUTH_API
  TOUR_API
  USER_UPLOAD
}

// ======== User Table =========

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @db.VarChar(255)
  password              String?                @db.Text
  nickname              String                 @db.VarChar(100)
  role                  UserRole               @default(USER)
  profileImage          String?                @map("profile_image") @db.Text
  provider              Provider               @default(LOCAL)
  providerId            String?                @map("provider_id") @db.VarChar(255)
  language              String                 @default("ko") @db.VarChar(255)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  profile               UserProfile?
  userPoint             UserPoint[]
  localVerifications    LocalVerification[]
  venues                Venue[]
  tags                  Tag[]
  reviews               Review[]
  businessVerifications BusinessVerification[]
  reviewHelpfuls        ReviewHelpful[]
  destinations          Destination[]

  @@unique([provider, providerId])
  @@map("users")
}

model UserProfile {
  id              String     @id @default(uuid()) @db.Uuid
  detailedAddress String?    @map("detailed_address") @db.Text
  latitude        Float?
  longitude       Float?
  introduction    String     @db.Text
  reviewCount     Int        @default(0) @map("review_count")
  helpfulCount    Int        @default(0) @map("helpful_count")
  deletedAt       DateTime?  @map("deleted_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  //테이블 연관요소
  userId          String    @unique @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  regionId        String?    @map("region_id") @db.Uuid
  region          Region?    @relation(fields: [regionId], references: [id])

  @@map("user_profiles")
}

model LocalVerification {
  id                 String             @id @default(uuid()) @db.Uuid
  longitude          Float
  latitude           Float
  verificationMethod VerificationMethod @map("verification_method")
  createdAt          DateTime           @default(now()) @map("created_at")
  deletedAt          DateTime?          @map("deleted_at")
  //테이블 간 연관요소
  userId             String             @map("user_id") @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId            String?            @map("venue_id") @db.Uuid
  venue              Venue?             @relation(fields: [venueId], references: [id])
  regionId           String?            @map("region_id") @db.Uuid
  region             Region?            @relation(fields: [regionId], references: [id], onDelete: Cascade)
  userPoint          UserPoint[]
  review             Review? 

  @@map("local_verifications")
}

model UserPoint {
  id                  String              @id @default(uuid()) @db.Uuid
  point               Int                 @default(0)
  pointActivity       PointType           @map("point_activity")
  localVerified       VerificationMethod? @map("local_verified")
  createdAt           DateTime            @default(now()) @map("created_at")
  deletedAt           DateTime?           @map("deleted_at")
  //연관요소  
  userId              String              @map("user_id") @db.Uuid
  localVerificationId String?             @map("local_verification_id") @db.Uuid
  venueId             String?             @map("venue_id") @db.Uuid
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue               Venue?              @relation(fields: [venueId], references: [id])
  localVerification   LocalVerification?  @relation(fields: [localVerificationId], references: [id])

  @@map("user_points")
}

model BusinessVerification {
  id               String    @id @default(uuid()) @db.Uuid
  businessName     String    @map("business_name") @db.VarChar(100)
  businessNumber   String    @map("business_number") @db.VarChar(100)
  businessVerified Boolean   @default(false) @map("business_verified")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  // user테이블 관련요소 
  userId           String    @unique @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_verification")
}

//region table
model Region {
   id                 String              @id @default(uuid()) @db.Uuid
   name               String              @db.VarChar(100)
   level              Int                 //1.country, 2.city, 3:district 

   parentId           String?             @map("parent_id") @db.Uuid 
   parent             Region?             @relation("RegionalHierachy", fields:[parentId], references:[id])
   children           Region[]            @relation("RegionalHierachy")

   userProfiles       UserProfile[]
   localVerifications LocalVerification[]
   venues             Venue[]
   destinations       Destination[]

  @@unique([parentId, name, level], name:"region_depth")
  @@map("regions")
}


// ====== Venue Table ======
model Venue {
  id                 String              @id @default(uuid()) @db.Uuid
  name               Json
  description        Json?
  venueCategory      VenueCategory?
  detailedAddress    String?             @map("detailed_address") @db.Text
  latitude           Float?
  longitude          Float?
  tourApiContentId   String?             @map("tour_api_content_id")
  googlePlaceId      String?             @map("google_place_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  //user table, local verification 연관요소
  createdBy          String              @map("created_by") @db.Uuid
  user               User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  regionId           String              @map("region_id") @db.Uuid
  region             Region              @relation(fields: [regionId], references: [id], onDelete: Cascade)
  venueDetail        VenueDetail?
  localVerifications LocalVerification[]
  googlePlace        GooglePlace?
  venueImages        VenueImage[]
  venueTags          VenueTag[]
  venueStats         VenueStats?
  userPoints         UserPoint[]
  review             Review[]

  @@map("venues")
}

model VenueDetail { 
  id          String     @id @default(uuid()) @db.Uuid
  phoneNumber String?    @map("phone_number") @db.VarChar(100)
  priceRange  String?    @map("price_range") @db.VarChar(100)
  subCategory String?    @map("sub_category") @db.VarChar(100)
  websiteUrl  String?    @map("website_url") @db.VarChar(100)
  work_hour   Json?      @map("work_hour")
  description Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  //Venue와 연관   
  venueId     String    @unique @map("venue_id") @db.Uuid
  venue       Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_details")
}

model GooglePlace {
  id            String   @id @default(uuid()) @db.Uuid
  googlePlaceId String   @map("google_place_id") @db.VarChar(255)
  googleRating  Float?   @default(0) @map("google_rating")
  googleType    String?  @map("google_types") @db.VarChar(255)
  googleUrl     String?  @map("google_url")
  createdAt     DateTime @default(now()) @map("created_at")
  venueId       String   @unique @map("venue_id") @db.Uuid
  //테이블 연관내용
  venue         Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("google_place")
}

model VenueImage {
  id          String       @id @default(uuid()) @db.Uuid
  imageUrl    String       @map("image_url")
  isThumbnail Boolean      @default(false) @map("is_thumbnail")
  imageSource ImageSource? @map("image_source")
  createdAt   DateTime     @default(now()) @map("created_at")
  venueId     String       @map("venue_id") @db.Uuid
  //테이블 연관내용
  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_images")
}

model VenueStats {
  id             String @id @default(uuid()) @db.Uuid
  ratingAvg      Float  @default(0) @map("rating_avg")
  reviewCount    Int    @default(0) @map("review_count")
  localRatingAvg Float  @default(0) @map("local_rating_avg")
  venueId        String @unique @map("venue_id") @db.Uuid
  //table
  venue          Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_stats")
}

model Tag {
  id        String     @id @default(uuid()) @db.Uuid
  tagName   String     @unique @map("tag_name") @db.VarChar(100)
  systemTag Boolean    @default(false) @map("system_tag")
  // user Table
  creatorId String?    @map("creator_id") @db.Uuid
  user      User?      @relation(fields: [creatorId], references: [id])
  venueTags VenueTag[]

  @@map("tags")
}

model VenueTag {
  venueId   String   @map("venue_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tags  Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([venueId, tagId])
  @@map("venue_tags")
}

// ====== Review Table ======
model Review {
  id                   String               @id @default(uuid()) @db.Uuid
  rating               Int                  @default(0)
  contents             Json     
  authorRole           UserRole             @default(USER) @map("author_role")
  likeCount            Int                  @default(0) @map("like_count")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  deletedAt            DateTime?            @map("deleted_at")
  venueId              String               @map("venue_id") @db.Uuid
  venue                Venue                @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId               String               @map("user_id") @db.Uuid
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  localVerificationId  String?              @unique @map("local_verification_id") @db.Uuid
  localVerification    LocalVerification?   @relation(fields:[localVerificationId], references:[id])   
  reviewHelpfuls       ReviewHelpful[]
  reviewImages         ReviewImage[]
  reviewDetail         ReviewDetail?

  @@map("reviews")
}

model ReviewDetail {
  id            String    @id @default(uuid()) @db.Uuid
  tasteRating   Int       @default(0) @map("taste_rating")
  serviceRating Int       @default(0) @map("service_rating")
  priceRating   Int       @default(0) @map("price_rating")
  visitDate     DateTime? @map("visit_date")
  visitPurpose  String    @map("visit_purpose") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  reviewId      String    @unique @map("review_id") @db.Uuid
  review        Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_details")
}

//Review에 Helpful 클릭 (user는 helpful생성자)
model ReviewHelpful {
  id       String @id @default(uuid()) @db.Uuid
  reviewId String @map("review_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_helpful")
}

model ReviewImage {
  id        String  @id @default(uuid()) @db.Uuid
  mainImage Boolean @default(false)
  imageUrl  String  @map("image_url")
  reviewId  String  @map("review_id") @db.Uuid
  review    Review  @relation(fields: [reviewId], references: [id])

  @@map("review_images")
}

model Destination {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  regionId   String    @map("region_id") @db.Uuid
  priority   Int       @default(0) 
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id])
  region     Region    @relation(fields: [regionId], references: [id])

  @@unique([userId, regionId])
  @@map("destination")
}
{
  "name": "triptags",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --parallel --stream dev",
    "build": "pnpm build:shared && pnpm build:database && pnpm build:api && pnpm build:web",
    "build:database": "pnpm --filter @triptags/database build",
    "build:shared": "pnpm --filter @triptags/shared build",
    "build:api": "pnpm --filter @triptags/api build",
    "build:web": "pnpm --filter @triptags/web build",
    "db:generate": "pnpm --filter @triptags/database run db:generate",
    "db:migrate": "pnpm --filter @triptags/database run db:migrate",
    "db:studio": "pnpm --filter @triptags/database run db:studio",
    "db:reset": "pnpm --filter @triptags/database run db:reset",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "pnpm --parallel --stream start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3"
  }
}
